{
  "name": "@himoto/web",
  "version": "1.1.0",
  "description": "HIMOTO Frontend Dashboard in Next.js 15 App Router",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:management": "node scripts/check-management-data.cjs",
    "test:contracts": "node scripts/check-contract-autofill.cjs",
    "lint:management": "eslint \"src/components/management/**/*.{ts,tsx}\" \"src/components/contracts/**/*.{ts,tsx}\" \"src/lib/management/**/*.ts\" \"src/app/(management)/**/*.tsx\" src/fixtures/management-data.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.85.0"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "source-map-js": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.8",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "^5.7.3"
  }
}
